{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/interno/processar-alteracoes-agendadas",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/interno/processar-publicacoes",
      "schedule": "5 6 * * *"
    }
  ]
}
