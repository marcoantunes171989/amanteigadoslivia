{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/admin/:path*",
      "destination": "/api/admin-router?slug=:path*"
    },
    {
      "source": "/api/interno/:job",
      "destination": "/api/interno-router?job=:job"
    }
  ]
}
