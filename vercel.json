{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "doce-aurora.pedidoprime.com.br" }],
      "destination": "/produtos"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "padaria-norte.pedidoprime.com.br" }],
      "destination": "/produtos"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "/api/admin-router?slug=:path*"
    },
    {
      "source": "/api/interno/:job",
      "destination": "/api/interno-router?job=:job"
    },
    {
      "source": "/api/conteudo-site",
      "destination": "/api/catalogo?recurso=conteudo-site"
    },
    {
      "source": "/api/encomendas",
      "destination": "/api/vendas?recurso=encomendas"
    },
    {
      "source": "/loja/:empresa",
      "destination": "/produtos"
    },
    {
      "source": "/loja/:empresa/",
      "destination": "/produtos"
    },
    {
      "source": "/loja/:empresa/produtos",
      "destination": "/produtos"
    },
    {
      "source": "/loja/:empresa/carrinho",
      "destination": "/carrinho"
    },
    {
      "source": "/loja/:empresa/acompanhar",
      "destination": "/acompanhar"
    },
    {
      "source": "/loja/:empresa/admin",
      "destination": "/admin"
    },
    {
      "source": "/loja/:empresa/admin/",
      "destination": "/admin"
    }
  ]
}
