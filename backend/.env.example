# ============================================================
# Amanteigados Livia - backend environment example
#
# This file is safe to version.
# NEVER place real passwords or production secrets here.
# ============================================================

# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=3101

# PostgreSQL local (DEV)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=amanteigados_dev
DB_USER=amanteigados_dev_app
DB_PASSWORD=REPLACE_WITH_LOCAL_SECRET

# HOMOLOG / Vercel: connection string server-side only (Runtime APP).
# Never expose this as NEXT_PUBLIC_DATABASE_URL or VITE_DATABASE_URL.
# DATABASE_URL=postgresql://amanteigados_homolog_app@HOST:6543/postgres?sslmode=require
